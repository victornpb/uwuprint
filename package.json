{
  "name": "uwuprint",
  "prodName": "uwuPrint",
  "prodTagline": "Thermal printer driver",
  "productName": "UwuPrint",
  "version": "0.1.22",
  "description": "Desktop thermal printer driver",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "npm run build && electron .",
    "build": "vite build",
    "test": "node --check src/main/index.js && node --check src/main/image-processing.js && node --check src/main/temp-files.js && node --check src/preload/index.js && node --check src/main/dither.js && node --check src/hardware/printer-models.cjs && node --check src/hardware/ble-printer.js && node --check src/hardware/printer-protocol.mjs && node --check src/renderer/settings.js && node --check src/renderer/composables/usePreferences.js && node --check scripts/dev.js && npm run build",
    "package": "npm run build && electron-builder --dir",
    "make:mac": "npm run build && electron-builder --mac"
  },
  "author": "Victornpb",
  "license": "UNLICENSED",
  "dependencies": {
    "sharp": "^0.33.5",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "electron": "^40.6.1",
    "electron-builder": "^26.15.3",
    "prettier": "^3.7.4",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.victornpb.uwuprint",
    "productName": "UwuPrint",
    "directories": {
      "output": "release"
    },
    "icon": "src/assets/app-icon.png",
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "src/hardware/**/*",
      "src/assets/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "src/assets/app-icon.png",
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "src/assets/app-icon.png"
    },
    "asarUnpack": [
      "node_modules/sharp/**/*"
    ],
    "fileAssociations": [
      {
        "ext": [
          "png"
        ],
        "name": "PNG Image",
        "role": "Editor",
        "mimeType": "image/png"
      },
      {
        "ext": [
          "jpg",
          "jpeg"
        ],
        "name": "JPEG Image",
        "role": "Editor",
        "mimeType": "image/jpeg"
      },
      {
        "ext": [
          "webp"
        ],
        "name": "WebP Image",
        "role": "Editor",
        "mimeType": "image/webp"
      },
      {
        "ext": [
          "gif"
        ],
        "name": "GIF Image",
        "role": "Editor",
        "mimeType": "image/gif"
      },
      {
        "ext": [
          "tif",
          "tiff"
        ],
        "name": "TIFF Image",
        "role": "Editor",
        "mimeType": "image/tiff"
      },
      {
        "ext": [
          "bmp"
        ],
        "name": "Bitmap Image",
        "role": "Editor",
        "mimeType": "image/bmp"
      }
    ]
  }
}
